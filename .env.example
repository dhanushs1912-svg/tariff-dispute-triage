# Copy to .env and fill in the values marked REQUIRED. .env is git-ignored; never commit it.
# Nothing environment-specific is hard-coded in the code or images: everything below is injected
# at runtime by docker compose (env_file: .env).

# ---------------------------------------------------------------- REQUIRED: embedding model
# A sentence-transformers model supported by fastembed. The brief (section 12) recommends the
# small MiniLM-L6-v2 model from sentence-transformers; put its full Hugging Face id here.
# Used at image build time (baked into the image) and at runtime. Changing it builds a new index
# collection; the old one is left in place.
EMBED_MODEL=

# ---------------------------------------------------------------- Language model (via llm-gateway)
# Default: the local stub service, so the stack runs with no key and no cost.
# For real answers, set an OpenAI-compatible provider: its base URL (ending in /v1 or /openai/v1
# as the provider documents), your API key, and a model id from the provider's model list.
LLM_BASE_URL=http://llm-stub:8080/v1
LLM_API_KEY=
LLM_MODEL=stub-model
# Optional fallback provider, used when the primary's circuit is open, it keeps failing, or it is
# rate-limited. LLM_FALLBACK_MODEL may list several models, comma separated (tried in order; each
# has its own breaker and its own free-tier quota).
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Optional second provider (another company's OpenAI-compatible endpoint), tried after all of the
# above. Gives an independent quota and protects against one provider's outage.
LLM_FALLBACK2_BASE_URL=
LLM_FALLBACK2_API_KEY=
LLM_FALLBACK2_MODEL=
# List price per million tokens, used to record cost at call time (free tiers bill 0; set the
# provider's paid list price here to report what the same traffic would cost).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
# Ask the provider for JSON output (response_format json_object). Set false if unsupported.
LLM_JSON_MODE=true
# For reasoning models that accept it (low / medium / high). Leave empty for models that do not.
LLM_REASONING_EFFORT=
# Upper bound on completion tokens per call; reasoning tokens count towards it.
LLM_MAX_TOKENS_CAP=2000

# ---------------------------------------------------------------- Resilience (A5)
LLM_CALL_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8
# When every provider is rate-limited, wait for the earliest reset and try again for up to this long.
# Rate limits never trip the circuit breaker; outages and errors do.
LLM_RATE_LIMIT_WAIT_SECONDS=90
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=30
GATEWAY_CLIENT_TIMEOUT_SECONDS=150
TOOL_TIMEOUT_SECONDS=10
# Lets POST /admin/fault on the gateway simulate a provider outage (demo item 8).
ENABLE_FAULT_INJECTION=true

# ---------------------------------------------------------------- Agent loop bounds (A1)
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_WALL_SECONDS=90
MAX_VERIFY_ATTEMPTS=2
RUN_DEADLINE_SECONDS=240
REQUIRE_MODIFIER_SEARCH=true

# ---------------------------------------------------------------- Prompt versions (L2)
INTAKE_PROMPT_VERSION=v1
RESEARCH_PROMPT_VERSION=v2
VERIFIER_PROMPT_VERSION=v1

# Lets the evaluation harness pick the research prompt version and the modifier gate per run
# (header X-Eval-Overrides). Turn off outside development.
ALLOW_EVAL_OVERRIDES=true

# ---------------------------------------------------------------- Caching and rate limits (D7)
RUN_CACHE_ENABLED=true
RUN_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=86400
RATE_LIMIT_SUBMIT_PER_MIN=20
RATE_LIMIT_READ_PER_MIN=600
LIVE_SCORE_SAMPLE_RATE=0.25

# ---------------------------------------------------------------- Stub provider (D6)
STUB_DELAY_MS=1500
STUB_JITTER_MS=300

# ---------------------------------------------------------------- Internal service addresses
# These are the compose service names on the private network; change only if you rename services.
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=triage
DATABASE_URL=postgresql://triage:change-me-locally@postgres:5432/triage
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=kerc_corpus
LLM_GATEWAY_URL=http://llm-gateway:8001
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Where you open Jaeger in a browser (used to build links in /v1/runs/{id}/trace).
JAEGER_UI_URL=http://127.0.0.1:16686
GRAFANA_ADMIN_PASSWORD=change-me-locally
LOG_LEVEL=INFO
